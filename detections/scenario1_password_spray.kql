// Scenario 1 — Password Spray Detection with Per-Account Attribution
// Tactic: Credential Access (T1110.003 - Password Spraying)
//
// Identifies IPs conducting a genuine spray pattern (5+ failures, 1+ success),
// then attributes the success to the specific compromised account rather than
// flagging every targeted account indiscriminately.

let sprayIPs =
    SigninLogs
    | where TimeGenerated > ago(2h)
    | summarize Failed=countif(ResultType != "0"),
                Success=countif(ResultType == "0")
              by IPAddress
    | where Failed >= 5 and Success >= 1
    | distinct IPAddress;
SigninLogs
| where TimeGenerated > ago(2h)
| where IPAddress in (sprayIPs)
| where ResultType == "0"
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName

// Entity mapping:
//   Account -> UserPrincipalName
//   IP      -> IPAddress
//
// Rule scheduling:
//   Run every: 15 minutes
//   Lookup data from the last: 2 hours
