// Reference Persistence Run — Registry Run Key Detection (Uncontained)
// Tactic: Persistence (T1547.001 - Registry Run Keys / Startup Folder)
//
// Detects registry VALUE-SET persistence. Uses Event ID 13, not 12 --
// 12 is Object Create/Delete (registry KEY creation/deletion only).
// A "reg add" targeting an existing key path (e.g. adding a value under
// an already-existing Run key) logs as Event ID 13.
//
// No automated response is attached to this query -- this run is
// intentionally left uncontained, for forensics documentation only.

Event
| where Source == "Microsoft-Windows-Sysmon"
| where EventID == 13
| where EventData has "Updater"
| project TimeGenerated, Computer, EventData

// Companion query -- scheduled task creation (EventID 4698).
// NOTE: this table (SecurityEvent) was found to be empty in this
// environment -- the Data Collection Rule was scoped only to the Sysmon
// event channel, and Windows Security Event log collection was never
// configured. See docs/securityevent-dcr-gap.md.
//
// SecurityEvent
// | where EventID == 4698
// | project TimeGenerated, Computer, SubjectAccount, TaskName
